# Foundry package environment. `yarn install` copies this file to .env (never commit .env).
# Nothing here is secret: deploy keys live in encrypted Foundry keystores (~/.foundry/keystores).

# Hedera JSON-RPC endpoint used by fork tests and scripts (testnet default).
HEDERA_RPC_URL=https://testnet.hashio.io/api

# --- Oracle (DualOracle) -------------------------------------------------------------------------------
# Max age of the Chainlink HBAR/USD answer, in seconds. The testnet feed updates on ~0.5% moves.
CHAINLINK_MAX_AGE_SECONDS=14400
# Max age of the Supra HBAR/USDT price, in seconds.
SUPRA_MAX_AGE_SECONDS=10800
# Max disagreement between Chainlink and Supra before the oracle freezes, in basis points (300 = 3%).
MAX_ORACLE_DEVIATION_BPS=300

# --- Risk parameters (HbarCdpEngine) -------------------------------------------------------------------
# Collateral ratio required after minting or withdrawing (15000 = 150%).
MIN_COLLATERAL_RATIO_BPS=15000
# Vaults below this ratio can be liquidated (12500 = 125%). Must be > 10000 + LIQUIDATION_BONUS_BPS.
LIQUIDATION_RATIO_BPS=12500
# Liquidator bonus paid in collateral (1000 = 10%).
LIQUIDATION_BONUS_BPS=1000
# Smallest non-zero debt, in stablecoin base units (6 decimals): 1000000 = 1.00.
MIN_DEBT=1000000
# Cap on total stablecoin supply, in base units: 1000000000000 = 1,000,000.00.
DEBT_CEILING=1000000000000

# --- HTS stablecoin (created by `make create-stablecoin`) ----------------------------------------------
STABLECOIN_NAME="Scaffold CDP Dollar"
STABLECOIN_SYMBOL=SCD
# USD budget sent for the HTS token-creation fee (~1 USD); unused HBAR is swept back to the deployer.
STABLECOIN_CREATE_BUDGET_USD=2
